# Supabase — free tier. Create a project at https://supabase.com/dashboard
# Settings -> API. Both values below are safe to expose in a browser bundle;
# row-level security in supabase/migrations is what actually protects the data.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Optional. Enables the in-app offline toggle and the seeded demo scenarios
# (pre-contested batch, expiring stock). Leave "true" for judging.
VITE_DEMO_MODE=true

# ---------------------------------------------------------------------------
# OPTIONAL — natural-language request intake (English / Telugu).
#
# NOT prefixed VITE_, deliberately. A VITE_ prefix would bake this into the
# browser bundle where anyone could read it out and spend it. This is consumed
# only by api/parse-request.ts, running server-side on Vercel.
#
# Set it in Vercel under Settings -> Environment Variables, not in this file.
# Without it the app works exactly as before and the manual form is used.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
